<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>chzzkcup</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
        }
        #canvas-3d {
            display: block;
            width: 100% !important;
            height: 100% !important;
        }
        @font-face {
            font-family: 'Nemony2';
            src: url('./font/SDNemony2dBasicBdTTF.ttf') format('truetype');
            font-weight: bold;
            font-style: normal;
        }
    </style>
</head>
<body>
    <canvas id="canvas-3d"></canvas>
    

    <script type="importmap">
    {
        "imports": {
            "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
            "three/": "https://cdn.jsdelivr.net/npm/three@0.160.0/"
        }
    }
    </script>
    <script type="module">
        import * as THREE from 'three';
        import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
        import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
        import { MeshTransmissionMaterial } from './MeshTransmissionMaterial.js';

        function notifyLoaded() {
            if (window.parent !== window) {
                window.parent.postMessage({ type: 'loadingComplete' }, '*');
            }
        }

        const canvas = document.getElementById('canvas-3d');
        if (!canvas) { notifyLoaded(); throw new Error('no canvas'); }

        // Scene setup
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x000000); // 검은 배경

        const camera = new THREE.PerspectiveCamera(45, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
        camera.position.set(0, 0, 5);
        camera.lookAt(0, 0, 0);

        const renderer = new THREE.WebGLRenderer({ 
            canvas, 
            antialias: true, 
            alpha: false,
            powerPreference: 'high-performance'
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
        
        // CSS로 크기 제어하도록 설정 (인라인 스타일 제거)
        function setRendererSize() {
            const w = canvas.clientWidth || window.innerWidth;
            const h = canvas.clientHeight || window.innerHeight;
            if (w > 0 && h > 0) {
                // 렌더링 해상도 설정 (실제 픽셀 해상도)
                renderer.setSize(w, h);
                // 인라인 스타일을 즉시 CSS로 덮어쓰기 (반응형 유지)
                requestAnimationFrame(() => {
                    canvas.style.width = '100%';
                    canvas.style.height = '100%';
                });
                // 즉시도 설정
                canvas.style.width = '100%';
                canvas.style.height = '100%';
            }
        }
        setRendererSize();
        
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.0;

        // Environment lighting
        const pmrem = new THREE.PMREMGenerator(renderer);
        const envScene = new RoomEnvironment();
        scene.environment = pmrem.fromScene(envScene).texture;
        pmrem.dispose();

        const ambient = new THREE.AmbientLight(0xffffff, 0.8);
        scene.add(ambient);

        const keyLight = new THREE.DirectionalLight(0xffffff, 1.5);
        keyLight.position.set(3, 4, 2);
        scene.add(keyLight);

        const fillLight = new THREE.DirectionalLight(0xffffff, 0.8);
        fillLight.position.set(-2, 1, 1);
        scene.add(fillLight);

        // UI 파라미터 (디폴트 값)
        const uiParams = {
            textSize: 2.0,      // 텍스트 크기 배율 (200%)
            textLineHeight: 1.05, // 텍스트 행간 배율
            logoSize: 1.5       // 로고 크기 배율 (150%)
        };

        // 텍스트 플레인 생성 (nemony2 폰트)
        async function createTextTexture() {
            // 폰트 로드 대기
            const font = new FontFace('Nemony2', 'url(./font/SDNemony2dBasicBdTTF.ttf)');
            await font.load();
            document.fonts.add(font);

            const canvas = document.createElement('canvas');
            // 고해상도로 설정 (8192x4096) - WebGL 최대 텍스처 크기 고려
            const maxTextureSize = renderer.capabilities.maxTextureSize;
            const targetWidth = Math.min(8192, maxTextureSize);
            const targetHeight = Math.min(4096, Math.floor(maxTextureSize / 2));
            const width = targetWidth;
            const height = targetHeight;
            canvas.width = width;
            canvas.height = height;

            // 고품질 렌더링 설정
            const ctx = canvas.getContext('2d', {
                alpha: true,
                desynchronized: false,
                willReadFrequently: false
            });

            // 안티앨리어싱 활성화
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';

            // 배경 투명
            ctx.clearRect(0, 0, width, height);

            // 텍스트 스타일 (nemony2 폰트, 흰색, 자간 0, 큰 폰트 크기)
            const baseFontSize = Math.floor(width / 11.4); // 해상도에 비례한 폰트 크기
            const fontSize = baseFontSize * uiParams.textSize; // UI 파라미터 적용
            ctx.fillStyle = '#FFFFFF';
            ctx.font = `bold ${fontSize}px "Nemony2", sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.letterSpacing = '0em';

            // 부드러운 가장자리를 위한 텍스트 렌더링
            // 1. 약간의 그림자로 가장자리 부드럽게
            ctx.shadowColor = 'rgba(255, 255, 255, 0.3)';
            ctx.shadowBlur = 2;
            ctx.shadowOffsetX = 0;
            ctx.shadowOffsetY = 0;

            // 2. 텍스트 그리기 (개행 처리)
            const lines = ['스트리밍은', '계속됩니다'];
            const lineHeight = fontSize * uiParams.textLineHeight; // UI 파라미터 적용
            const totalHeight = lines.length * lineHeight;
            const startY = height / 2 - totalHeight / 2 + lineHeight / 2;
            
            lines.forEach((line, i) => {
                ctx.fillText(line, width / 2, startY + i * lineHeight);
            });

            // 3. 그림자 제거 후 다시 그리기 (더 선명하게)
            ctx.shadowBlur = 0;
            lines.forEach((line, i) => {
                ctx.fillText(line, width / 2, startY + i * lineHeight);
            });

            const texture = new THREE.CanvasTexture(canvas);
            texture.colorSpace = THREE.SRGBColorSpace;
            // 고품질 필터링 설정
            texture.minFilter = THREE.LinearMipmapLinearFilter; // Mipmap 사용으로 더 부드러운 축소
            texture.magFilter = THREE.LinearFilter; // 확대 시 선형 필터
            texture.anisotropy = renderer.capabilities.getMaxAnisotropy();
            texture.generateMipmaps = true; // Mipmap 생성 활성화
            texture.needsUpdate = true;
            return texture;
        }

        // 뷰포트 크기 계산 함수 (먼저 정의)
        function getViewportSize() {
            const distance = camera.position.z;
            const fov = camera.fov * (Math.PI / 180);
            const height = 2 * Math.tan(fov / 2) * distance;
            const width = height * camera.aspect;
            return { width, height };
        }

        // 텍스트 플레인 크기 업데이트 함수 (먼저 정의)
        function updateTextPlaneSize() {
            if (!textPlane) return;
            try {
                const w = canvas.clientWidth || window.innerWidth;
                const h = canvas.clientHeight || window.innerHeight;
                if (w === 0 || h === 0) return;
                
                // 화면 크기에 직접 비례하도록 계산
                // 카메라 거리 5, FOV 45도 기준으로 뷰포트 크기 계산
                const distance = camera.position.z;
                const fovRad = (camera.fov * Math.PI) / 180;
                const viewportHeight = 2 * Math.tan(fovRad / 2) * distance;
                const viewportWidth = viewportHeight * (w / h);
                
                // 화면 크기에 따라 마진과 크기 비율 조정
                const isMobile = w <= 768;
                const isTablet = w > 768 && w <= 1024;
                
                // 작은 화면일수록 더 큰 마진과 작은 크기 비율 적용
                let marginPx, sizeMultiplier;
                if (isMobile) {
                    marginPx = 40; // 모바일: 40px 마진
                    sizeMultiplier = 0.75; // 모바일: 75% 크기
                } else if (isTablet) {
                    marginPx = 30; // 태블릿: 30px 마진
                    sizeMultiplier = 0.85; // 태블릿: 85% 크기
                } else {
                    marginPx = 20; // 데스크톱: 20px 마진
                    sizeMultiplier = 1.0; // 데스크톱: 100% 크기
                }
                
                // 좌우 마진을 뷰포트 좌표계로 변환
                const marginRatio = (marginPx * 2) / w; // 양쪽 마진 합계 비율
                const marginWorld = viewportWidth * marginRatio; // 뷰포트 좌표계의 마진
                
                // 텍스트 플레인의 가로세로 비율 유지하면서 뷰포트에 맞춤 (UI 파라미터 적용, 마진 고려)
                const baseWidth = viewportWidth * 1.04; // 0.8 * 1.3 = 1.04
                const baseHeight = viewportHeight * 0.52; // 0.4 * 1.3 = 0.52
                const targetWidth = ((baseWidth * uiParams.textSize) - marginWorld) * sizeMultiplier; // 마진 제외 + 크기 조정
                const targetHeight = (baseHeight * uiParams.textSize) * sizeMultiplier;
                const scaleX = targetWidth / textPlaneBaseSize.width;
                const scaleY = targetHeight / textPlaneBaseSize.height;
                const scale = Math.min(scaleX, scaleY); // 비율 유지
                
                if (scale > 0 && isFinite(scale)) {
                    textPlane.scale.set(scale, scale, 1);
                }
            } catch (e) {
                console.error('updateTextPlaneSize error:', e);
            }
        }

        // 모델 크기 업데이트 함수 (먼저 정의)
        function updateModelSize() {
            if (!modelGroup || !modelGroup.userData.baseSize) return;
            try {
                const w = canvas.clientWidth || window.innerWidth;
                const h = canvas.clientHeight || window.innerHeight;
                if (w === 0 || h === 0) return;
                
                // 화면 크기에 직접 비례하도록 계산
                const distance = camera.position.z;
                const fovRad = (camera.fov * Math.PI) / 180;
                const viewportHeight = 2 * Math.tan(fovRad / 2) * distance;
                const viewportWidth = viewportHeight * (w / h);
                const viewportSize = Math.min(viewportWidth, viewportHeight);
                
                const baseSize = viewportSize * 0.39; // 뷰포트의 39% (0.3 * 1.3 = 0.39)
                const targetSize = baseSize * uiParams.logoSize; // UI 파라미터 적용
                const scale = targetSize / modelGroup.userData.baseSize;
                
                if (scale > 0 && isFinite(scale)) {
                    modelGroup.scale.setScalar(scale);
                }
            } catch (e) {
                console.error('updateModelSize error:', e);
            }
        }

        // 텍스트 플레인 생성 (비동기)
        let textPlane = null;
        let textPlaneBaseSize = { width: 8, height: 4 }; // 기본 크기 (비율 유지)
        let textTexture = null;
        
        async function initTextPlane() {
            const newTexture = await createTextTexture();
            
            // 기존 텍스처 메모리 해제
            if (textTexture) {
                textTexture.dispose();
            }
            textTexture = newTexture;
            
            if (!textPlane) {
                textPlane = new THREE.Mesh(
                    new THREE.PlaneGeometry(textPlaneBaseSize.width, textPlaneBaseSize.height),
                    new THREE.MeshBasicMaterial({
                        map: textTexture,
                        transparent: false,
                        side: THREE.DoubleSide
                    })
                );
                textPlane.position.set(0, 0, -2);
                textPlane.renderOrder = 0;
                scene.add(textPlane);
            } else {
                // 텍스처만 업데이트
                textPlane.material.map = textTexture;
                textPlane.material.needsUpdate = true;
            }
            updateTextPlaneSize(); // 초기 크기 설정
        }
        
        initTextPlane();

        // FBO 버퍼 생성 (굴절용) - 높은 해상도로 배경과 굴절 매칭 개선
        let transmissionFbo = null;
        const FBO_MAX = 1024; // 해상도 증가로 더 정확한 굴절
        function getTransmissionFbo() {
            const w = canvas.clientWidth || 1;
            const h = canvas.clientHeight || 1;
            const scale = Math.min(1, FBO_MAX / Math.max(w, h));
            const fw = Math.max(256, (w * scale) | 0);
            const fh = Math.max(256, (h * scale) | 0);
            if (!transmissionFbo || transmissionFbo.width !== fw || transmissionFbo.height !== fh) {
                if (transmissionFbo) transmissionFbo.dispose();
                transmissionFbo = new THREE.WebGLRenderTarget(fw, fh, {
                    minFilter: THREE.LinearFilter,
                    magFilter: THREE.LinearFilter,
                    format: THREE.RGBAFormat,
                    type: THREE.UnsignedByteType
                });
            }
            return transmissionFbo;
        }

        // 재질 파라미터 (모델 윤곽에 맞춘 굴절 강화)
        const params = {
            thickness: 1.2, // 굴절 두께 증가 (모델 윤곽에 맞춰)
            roughness: 0.1,
            ior: 1.6, // 굴절률 증가 (더 강한 굴절)
            chromaticAberration: 0.02,
            distortion: 0.6, // 왜곡 강도 대폭 증가
            distortionScale: 0.8, // 왜곡 스케일 증가
            temporalDistortion: 0.2 // 시간 기반 왜곡 증가
        };

        // MeshTransmissionMaterial 생성
        function createGlassMaterial() {
            const mat = new MeshTransmissionMaterial({
                transmission: 1,
                chromaticAberration: params.chromaticAberration,
                thickness: params.thickness,
                roughness: params.roughness,
                distortion: params.distortion,
                distortionScale: params.distortionScale,
                temporalDistortion: params.temporalDistortion,
                attenuationColor: new THREE.Color(0xffffff),
                attenuationDistance: Infinity,
                samples: 10 // 샘플 수 증가로 더 정확한 굴절
            });
            mat.color.setHex(0xffffff);
            mat.ior = params.ior;
            mat.metalness = 0;
            mat.clearcoat = 0.2;
            mat.clearcoatRoughness = 0;
            mat.envMapIntensity = 1;
            mat.side = THREE.DoubleSide;
            return mat;
        }

        // 3D 로고 모델 로드
        let modelGroup = new THREE.Group();
        modelGroup.position.set(0, 0, 0);
        scene.add(modelGroup);

        const loader = new GLTFLoader();
        const glbPath = window.location.href.replace(/[^/]*$/, '') + 'Logo.glb';

        loader.load(
            glbPath,
            function (gltf) {
                const root = gltf.scene;
                
                // 중앙 정렬 및 스케일 조정
                const box = new THREE.Box3().setFromObject(root);
                const center = new THREE.Vector3();
                const size = new THREE.Vector3();
                box.getCenter(center);
                box.getSize(size);
                root.position.sub(center);
                
                const maxDim = Math.max(size.x, size.y, size.z);
                if (maxDim > 0) {
                    root.scale.setScalar(2.2 / maxDim); // 로고 크기 증가
                }
                
                // 다시 중앙 정렬 (스케일 후)
                box.setFromObject(root);
                box.getCenter(center);
                root.position.sub(center);
                
                // 모델 크기 기반으로 thickness 동적 계산
                const scaledSize = new THREE.Vector3();
                box.getSize(scaledSize);
                const avgThickness = (scaledSize.x + scaledSize.y + scaledSize.z) / 3;
                // 모델의 평균 두께를 기반으로 thickness 조정 (0.3 ~ 1.5 범위)
                const dynamicThickness = Math.max(0.3, Math.min(1.5, avgThickness * 0.8));
                params.thickness = dynamicThickness;
                
                // 재질 적용 (동적 thickness 사용)
                root.traverse(function (child) {
                    if (child.isMesh) {
                        const mat = createGlassMaterial();
                        mat.thickness = dynamicThickness;
                        child.material = mat;
                    }
                });
                
                // 약간 회전 (이미지처럼)
                root.rotation.y = Math.PI * 0.1;
                root.rotation.x = Math.PI * 0.05;
                
                // 초기 회전 각도를 currentRotation에 반영
                currentRotation.x = Math.PI * 0.05;
                currentRotation.y = Math.PI * 0.1;
                currentRotation.z = 0;
                
                modelGroup.add(root);
                
                // 모델 기본 크기 저장 (뷰포트 비율 계산용)
                const modelBox = new THREE.Box3().setFromObject(root);
                const modelSize = new THREE.Vector3();
                modelBox.getSize(modelSize);
                modelGroup.userData.baseSize = Math.max(modelSize.x, modelSize.y, modelSize.z);
                
                updateModelSize(); // 초기 크기 설정
                onResize();
                notifyLoaded();
            },
            undefined,
            function (error) {
                console.error('GLB load error:', error);
                notifyLoaded();
            }
        );

        const clock = new THREE.Clock();
        let lastTime = 0;

        // 마우스 드래그 회전 제어
        let isDragging = false;
        let previousMousePosition = { x: 0, y: 0 };
        let rotationSpeed = { x: 0, y: 0, z: 0 }; // 자동 회전 속도
        let currentRotation = { x: 0, y: 0, z: 0 }; // 현재 회전 각도

        // 마우스 이벤트 핸들러
        function onMouseDown(event) {
            isDragging = true;
            previousMousePosition = {
                x: event.clientX,
                y: event.clientY
            };
            canvas.style.cursor = 'grabbing';
        }

        function onMouseMove(event) {
            if (!isDragging || !modelGroup || modelGroup.children.length === 0) return;

            const deltaX = event.clientX - previousMousePosition.x;
            const deltaY = event.clientY - previousMousePosition.y;

            // 마우스 이동량에 비례해 회전 (Y축은 수평, X축은 수직)
            const rotationSpeed = 0.005;
            currentRotation.y += deltaX * rotationSpeed;
            currentRotation.x -= deltaY * rotationSpeed;

            modelGroup.rotation.y = currentRotation.y;
            modelGroup.rotation.x = currentRotation.x;

            previousMousePosition = {
                x: event.clientX,
                y: event.clientY
            };
        }

        function onMouseUp() {
            isDragging = false;
            canvas.style.cursor = 'grab';
        }

        // 터치 이벤트 지원
        function onTouchStart(event) {
            if (event.touches.length === 1) {
                isDragging = true;
                previousMousePosition = {
                    x: event.touches[0].clientX,
                    y: event.touches[0].clientY
                };
            }
        }

        function onTouchMove(event) {
            if (!isDragging || !modelGroup || modelGroup.children.length === 0) return;
            if (event.touches.length !== 1) return;

            const deltaX = event.touches[0].clientX - previousMousePosition.x;
            const deltaY = event.touches[0].clientY - previousMousePosition.y;

            const rotationSpeed = 0.005;
            currentRotation.y += deltaX * rotationSpeed;
            currentRotation.x -= deltaY * rotationSpeed;

            modelGroup.rotation.y = currentRotation.y;
            modelGroup.rotation.x = currentRotation.x;

            previousMousePosition = {
                x: event.touches[0].clientX,
                y: event.touches[0].clientY
            };
        }

        function onTouchEnd() {
            isDragging = false;
        }

        // 이벤트 리스너 등록
        canvas.addEventListener('mousedown', onMouseDown);
        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
        canvas.addEventListener('touchstart', onTouchStart);
        canvas.addEventListener('touchmove', onTouchMove);
        canvas.addEventListener('touchend', onTouchEnd);
        canvas.style.cursor = 'grab';

        // 이전 캔버스 크기 저장 (실시간 반응을 위해)
        let lastCanvasSize = { width: -1, height: -1 };
        let needsResize = true; // 초기 리사이즈 플래그
        
        function animate(time) {
            requestAnimationFrame(animate);
            const dt = lastTime ? (time - lastTime) / 1000 : 0.016;
            lastTime = time;

            // 매 프레임마다 캔버스 크기 확인하여 변경 시 업데이트
            const currentWidth = canvas.clientWidth || window.innerWidth;
            const currentHeight = canvas.clientHeight || window.innerHeight;
            
            // 크기가 변경되었거나 초기화가 필요한 경우
            if (needsResize || currentWidth !== lastCanvasSize.width || currentHeight !== lastCanvasSize.height) {
                lastCanvasSize.width = currentWidth;
                lastCanvasSize.height = currentHeight;
                needsResize = false;
                
                // 카메라 및 렌더러 업데이트
                if (currentWidth > 0 && currentHeight > 0) {
                    camera.aspect = currentWidth / currentHeight;
                    camera.updateProjectionMatrix();
                    setRendererSize(); // CSS 제어 방식 사용
                    
                    // 요소 크기 즉시 업데이트 (다음 프레임에서도 확실히 적용)
                    requestAnimationFrame(() => {
                        updateTextPlaneSize();
                        updateModelSize();
                    });
                    // 즉시도 한 번 실행
                    updateTextPlaneSize();
                    updateModelSize();
                }
            }

            // 드래그 중이 아닐 때만 자동 회전 (속도 감소)
            if (modelGroup && modelGroup.children.length && !isDragging) {
                rotationSpeed.x = 0.003 * 60 * dt; // X축 회전 속도 감소
                rotationSpeed.y = 0.004 * 60 * dt; // Y축 회전 속도 감소
                rotationSpeed.z = 0.002 * 60 * dt; // Z축 회전 속도 감소
                
                currentRotation.x += rotationSpeed.x;
                currentRotation.y += rotationSpeed.y;
                currentRotation.z += rotationSpeed.z;
                
                modelGroup.rotation.x = currentRotation.x;
                modelGroup.rotation.y = currentRotation.y;
                modelGroup.rotation.z = currentRotation.z;
            }

            // FBO 버퍼 패스: 로고를 제외한 씬을 먼저 렌더링
            const fbo = getTransmissionFbo();
            const hasTransmission = modelGroup.children.length > 0 && textPlane;

            if (hasTransmission) {
                // FBO 렌더링을 위한 카메라 설정 저장
                const prevAspect = camera.aspect;
                const prevFov = camera.fov;
                const prevNear = camera.near;
                const prevFar = camera.far;
                
                // FBO 비율에 맞춰 카메라 설정
                camera.aspect = fbo.width / fbo.height;
                camera.updateProjectionMatrix();

                // 로고 숨기고 배경+텍스트만 렌더링
                modelGroup.visible = false;
                renderer.setRenderTarget(fbo);
                
                // 배경을 명시적으로 클리어 (검은색)
                renderer.setClearColor(0x000000, 1);
                renderer.clear();
                
                // 씬 렌더링 (배경 + 텍스트)
                renderer.render(scene, camera);

                // 카메라 설정 복원
                camera.aspect = prevAspect;
                camera.fov = prevFov;
                camera.near = prevNear;
                camera.far = prevFar;
                camera.updateProjectionMatrix();

                // 로고 다시 보이게
                modelGroup.visible = true;

                // 재질에 버퍼와 시간 전달
                const elapsed = clock.getElapsedTime();
                modelGroup.traverse((obj) => {
                    if (obj.isMesh && obj.material && obj.material.uniforms) {
                        obj.material.buffer = fbo.texture;
                        obj.material.time = elapsed;
                    }
                });
            }

            // 최종 렌더링
            renderer.setRenderTarget(null);
            renderer.setClearColor(0x000000, 1); // 배경 색상 명시적으로 설정
            renderer.render(scene, camera);
        }
        requestAnimationFrame(animate);


        // 리사이즈 핸들러 (추가 보조용)
        function onResize() {
            needsResize = true; // 리사이즈 필요 플래그 설정
        }

        // 여러 이벤트 리스너로 확실하게 감지
        window.addEventListener('resize', onResize, { passive: true });
        window.addEventListener('orientationchange', onResize);
        
        if (typeof ResizeObserver !== 'undefined') {
            const resizeObserver = new ResizeObserver(function (entries) {
                needsResize = true;
            });
            resizeObserver.observe(canvas);
            resizeObserver.observe(document.body);
        }
        
        // 초기화 시 리사이즈 필요 플래그 설정
        needsResize = true;

        // 페이지 로드 완료 알림
        requestAnimationFrame(function () {
            notifyLoaded();
        });
    </script>
</body>
</html>
